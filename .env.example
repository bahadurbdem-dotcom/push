# লোকাল পরীক্ষার জন্য এই ফাইলের নাম .env দিন (Render এ এগুলো Environment এ বসাতে হয়)
# ---------------------------------------------------------------
# অ্যাডমিন প্যানেল থেকে পুশ পাঠানোর গোপন চাবি (কমপক্ষে ২০ অক্ষর, এলোমেলো)
ADMIN_KEY=change-this-to-a-long-random-secret

# Firebase Service Account — Render এ "Secret File" (serviceAccountKey.json) ব্যবহার করুন।
# লোকালে চালালে এই ফোল্ডারে serviceAccountKey.json রাখুন। অথবা পুরো JSON এক লাইনে:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# OTP পাঠানোর জিমেইল (Gmail API, HTTPS দিয়ে — Render ফ্রি তে SMTP বন্ধ থাকে তাই এটাই ব্যবহার হয়)
GMAIL_USER=yourstore@gmail.com
GMAIL_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxx
GMAIL_REFRESH_TOKEN=1//0xxxxxxxx

# ঐচ্ছিক
STORE_NAME=IS Fashion
# শুধু নির্দিষ্ট ওয়েবসাইট থেকে অনুমতি দিতে (কমা দিয়ে); ফাঁকা = সব
ALLOWED_ORIGINS=
